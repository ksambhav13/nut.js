{
  "name": "@orionstario/provider-interfaces",
  "version": "4.2.0",
  "description": "Public provider interfaces for @orionstario/nut-js",
  "main": "dist/index",
  "typings": "dist/index",
  "scripts": {
    "clean": "rimraf dist",
    "compile": "pnpm run clean && tsc -p .",
    "publish:next": "pnpm publish --tag next --no-git-checks --access public",
    "publish:release": "pnpm publish --no-git-checks --access public",
    "prepublishOnly": "pnpm run compile",
    "typedoc": "typedoc --out docs"
  },
  "keywords": [
    "nut-js",
    "provider"
  ],
  "author": {
    "name": "dry Software UG (haftungsbeschränkt)",
    "email": "info@dry.software",
    "url": "https://dry.software"
  },
  "license": "Apache-2.0",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "dependencies": {
    "@orionstario/shared": "workspace:*"
  },
  "devDependencies": {
    "@orionstario/configs": "workspace:*"
  }
}
